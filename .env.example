# Copy to .env and fill in. Never commit .env.
# Create a key: Google Cloud Console -> APIs & Services -> enable "YouTube Data API v3" -> Credentials -> API key
YOUTUBE_API_KEY=

# Optional: default video ID for `python -m src.youtube_ingest` (11-char ID from the watch URL)
YOUTUBE_VIDEO_ID=

# Optional: override output locations
# RAW_DIR=raw
# SILVER_PATH=data/processed/youtube_messages.parquet
# GOLD_PATH=data/analytics/author_summary.parquet
